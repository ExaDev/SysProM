{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"paths": {
			"@sysprom/core": ["../core/src/index.ts"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
