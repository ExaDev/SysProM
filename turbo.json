{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"_lint": {
			"dependsOn": ["@sysprom/core#build"],
			"inputs": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.ts"],
			"outputs": []
		},
		"_typecheck": {
			"dependsOn": ["@sysprom/core#build"],
			"inputs": ["src/**/*.ts", "tests/**/*.ts", "tsconfig.json"],
			"outputs": []
		},
		"_compile": {
			"dependsOn": ["_typecheck", "@sysprom/core#build"],
			"inputs": [
				"src/**/*.ts",
				"packages/core/src/**/*.ts",
				"tsconfig.json",
				"tsdown.config.ts"
			],
			"outputs": ["dist/**"]
		},
		"_schema": {
			"dependsOn": ["_compile"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["schema.json"]
		},
		"_test": {
			"dependsOn": ["_typecheck", "@sysprom/core#build"],
			"inputs": ["src/**/*.ts", "tests/**/*.ts"],
			"outputs": []
		},
		"_test:coverage": {
			"dependsOn": ["_typecheck", "@sysprom/core#build"],
			"inputs": ["src/**/*.ts", "tests/**/*.ts"],
			"outputs": ["coverage/**"],
			"cache": false
		},
		"_docs:cli": {
			"inputs": [
				"src/cli/**/*.ts",
				"scripts/generate-cli-docs.ts"
			],
			"outputs": ["docs/cli/**"]
		},
		"_docs:api": {
			"inputs": ["src/**/*.ts", "typedoc.json"],
			"outputs": ["docs/api/**"]
		},
		"_docs:api:html": {
			"dependsOn": ["_docs:cli"],
			"inputs": ["src/**/*.ts", "typedoc.html.json", "docs/cli/**"],
			"outputs": ["site/**"]
		},
		"_build": {
			"dependsOn": [
				"_compile",
				"_schema",
				"_docs:cli",
				"_docs:api",
				"@sysprom/core#build"
			],
			"outputs": []
		},
		"_validate": {
			"dependsOn": ["_lint", "_typecheck", "_build", "_test"],
			"outputs": []
		}
	}
}
